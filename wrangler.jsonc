{
  "name": "gtaklips",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "triggers": { "crons": ["0 6,18 * * *"] },
  "vars": {
    "PUBLIC_ORIGIN": "https://example.com",
    "ACCESS_ISSUER": "",
    "ACCESS_AUDIENCE": "",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gtaklips",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
}

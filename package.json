{
  "name": "gtaklips",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --config wrangler.local.jsonc --ip 127.0.0.1",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "build": "wrangler deploy --dry-run --outdir dist",
    "test:e2e": "playwright test",
    "db:local": "wrangler d1 migrations apply DB --local --config wrangler.local.jsonc",
    "seed:demo": "node scripts/seed-demo.mjs",
    "bot": "node --env-file=.env.telegram --import tsx src/telegram-runner.ts",
    "bot:status": "node --env-file=.env.telegram --import tsx src/telegram-runner.ts --status"
  },
  "dependencies": {
    "jose": "^6.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261118.1",
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.0.0",
    "miniflare": "^5.20261117.0-beta",
    "prettier": "^3.10.1",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "wrangler": "^4.0.0"
  }
}

{
  "name": "gtaklips-local",
  "main": "src/local.ts",
  "compatibility_date": "2026-11-01",
  "vars": {
    "PUBLIC_ORIGIN": "http://127.0.0.1:8787",
    "LOCAL_DEVELOPMENT": "explicit-loopback-only",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gtaklips",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
}
